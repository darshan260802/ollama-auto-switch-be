# Copy this file to .env for local development.
# On Render, set these in the Environment dashboard.

# Required: full JSON content of the Firebase service account private key.
# Get it from Firebase Console → Project Settings → Service Accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: public URL of this backend. Used by the keep-alive ping in production.
DEPLOYMENT_URL=https://ollama-auto-switch-be.onrender.com

# Optional: port for local development. Render sets this automatically.
PORT=3000
